# Anthropic on Vertex (used for question gen, gold-script codegen, Claude reviewer/judge)
ANTHROPIC_VERTEX_PROJECT_ID=kehllab-caia-v2
CLAUDE_CODE_USE_VERTEX=1
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json
ANTHROPIC_VERTEX_REGION=global
CLINGEN_CLAUDE_MODEL=claude-opus-4-8
# CLINGEN_CLAUDE_EFFORT=xhigh  # optional; unsupported by Claude Haiku 4.5

# Azure OpenAI (BAA-covered; used for OpenAI reviewer/judge)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Assess task: `clingen-bench assess --model <provider>:<model>` calls the model
# API directly (no adapter, no tools). Each provider reads:
#   vertex-anthropic   ANTHROPIC_VERTEX_PROJECT_ID; region from CLOUD_ML_REGION
#                      or ANTHROPIC_VERTEX_REGION (default global)
#   vertex-openai      --project or GOOGLE_CLOUD_PROJECT (falls back to
#                      ANTHROPIC_VERTEX_PROJECT_ID); Google application-default credentials
#   azure-openai       AZURE_OPENAI_ENDPOINT as the v1 base URL
#                      (https://<resource>.openai.azure.com/openai/v1);
#                      AZURE_OPENAI_API_KEY, or a token from `az account get-access-token`
#   openai-compatible  --base-url or CLINGEN_ASSESS_BASE_URL; key from --api-key-env
# CLINGEN_ASSESS_BASE_URL=http://127.0.0.1:8000/v1

# Cohort data root (required): directory containing the cohort folders
CLINGEN_DATA_ROOT=

# Gold root — holds everything the agent-under-eval must NOT see: the gold
# question bank, gold_standard/ scripts+results, and the review workbook. Kept
# OUTSIDE the repo. Defaults to the sibling ../clin-genomic-analysis-benchmark_gold.
# CLINGEN_GOLD_ROOT=

# Codex + vLLM adapter (adapters/codex_qwen3.6-35B-A3B) — open-source model via
# the local Codex `vllm` profile. All optional; sensible defaults in the adapter.
VLLM_TOKEN=EMPTY                     # auth token for the local vLLM endpoint
# CODEX_PROFILE=vllm                 # Codex profile to layer (default: vllm)
# CODEX_MODEL_PROVIDER=azure         # provider key from ~/.codex/config.toml
# CODEX_MODEL=                       # override served model (default: profile's)
# CODEX_REASONING_EFFORT=xhigh       # explicit Codex reasoning effort
# CODEX_SANDBOX_MODE=workspace-write # analyze sandbox; or danger-full-access
# CODEX_BIN=codex                    # path to the codex binary

# Codex + Gemma 4 26B on Vertex Agent Platform. Authentication is obtained by
# the trusted adapter with `gcloud auth print-access-token`; credentials are not
# mounted into the model-controlled Codex sandbox.
# VERTEX_GEMMA_PROJECT_ID=your-gcp-project  # required
# VERTEX_GEMMA_LOCATION=global             # model is currently global
# VERTEX_GEMMA_MAX_RETRIES=6               # retries 429 and transient 5xx
# VERTEX_GEMMA_MAX_OUTPUT_TOKENS=16384
